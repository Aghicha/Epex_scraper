# Copy to .env and fill in — .env itself is gitignored, never committed.

# ENTSO-E Transparency Platform security token, required for tradingsurv's
# generation/load/outage/capacity ingestion (tradingsurv/ingestion/entsoe/).
# Register for free at https://transparency.entsoe.eu/ (account settings ->
# "Web Api Security Token").
ENTSOE_API_TOKEN=

# Optional: comma-separated proxy URLs for epex_scraper (see README.md).
# EPEX_PROXIES=
